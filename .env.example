# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider (GWDG Academic Cloud) ────────────────────────────────────
GWDG_MODEL_URL=https://chat-ai.academiccloud.de/v1
GWDG_MODEL_API_KEY=your_api_key_here

# ── Kubernetes cluster ─────────────────────────────────────────────────────
# For local mock:  http://localhost:9988
# For real cluster: update to your cluster's API endpoint
K8S_MOCK_URL=http://localhost:9988

# ── Agent model selection ──────────────────────────────────────────────────
AGENT_LLM_PROVIDER=GWDG
AGENT_LLM_MODEL=your_model_name_here

# ── Tool/function-calling model (optional, can be same as agent) ───────────
# TOOL_LLM_PROVIDER=GWDG
# TOOL_LLM_MODEL=your_tool_model_name_here
